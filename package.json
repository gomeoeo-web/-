{
  "name": "my-app-tracker",
  "version": "1.10.0",
  "description": "期效管家 - 極簡物品生命週期與保固管家",
  "private": true,
  "main": "index.html",
  "scripts": {
    "build": "node scripts/build.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open": "npx cap open android",
    "test": "node scripts/test-current.mjs",
    "test:legacy": "node --test tests/*_features.test.mjs",
    "test:release": "npm test && node tests/shared-live-runtime.mjs && node tests/features-110-browser.mjs && node tests/shared-immediate-browser.mjs && node tests/new-item-save-browser.mjs && node tests/item-icon-text-browser.mjs && node tests/item-save-safety-browser.mjs",
    "test:browser": "node tests/features-110-browser.mjs",
    "cloud:login": "wrangler login",
    "cloud:deploy": "wrangler deploy --config backend/wrangler.jsonc",
    "cloud:check": "wrangler deploy --dry-run --config backend/wrangler.jsonc",
    "test:pending": "node tests/pending-browser.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "playwright": "^1.63.0",
    "wrangler": "^4.133.0"
  }
}
